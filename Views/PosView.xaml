<UserControl x:Class="CheckBarcodeSieuThi.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CheckBarcodeSieuThi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosViewModel}"
             d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding CheckoutCommand}" />
        <KeyBinding Key="F8" Command="{Binding ClearCartCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Cột của bảng giỏ hàng: dùng chung cho dòng tiêu đề và từng dòng hàng -->
        <GridLength x:Key="ColIndex">44</GridLength>
        <GridLength x:Key="ColPrice">100</GridLength>
        <GridLength x:Key="ColQty">136</GridLength>
        <GridLength x:Key="ColTotal">112</GridLength>
        <GridLength x:Key="ColRemove">48</GridLength>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ================= GIỎ HÀNG ================= -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <!-- Ô quét mã -->
                <Grid DockPanel.Dock="Top" Margin="20,20,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ScanBox" FontSize="18" Padding="48,12,12,12"
                                 Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Quét hoặc nhập mã vạch rồi nhấn Enter   (F2)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddFromScanBoxCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE8B3;" Style="{StaticResource Text.Icon}" FontSize="20" HorizontalAlignment="Left"
                                   Margin="16,0,0,0" Foreground="{StaticResource InkMuted}" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0" Padding="20,0"
                            Command="{Binding AddFromScanBoxCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Thêm" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Thông báo -->
                <Border DockPanel.Dock="Top" Margin="20,0,20,14" CornerRadius="8" Padding="14,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="{x:Static vm:NoticeKind.Success}">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessLine}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="{x:Static vm:NoticeKind.Error}">
                                    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerLine}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoticeText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Danger}" Padding="12,5" FontSize="13"
                                Command="{Binding AddUnknownProductCommand}"
                                Visibility="{Binding HasUnknownBarcode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="Thêm vào danh mục" />
                            </StackPanel>
                        </Button>
                        <TextBlock FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeKind}" Value="{x:Static vm:NoticeKind.Success}">
                                            <Setter Property="Text" Value="&#xE73E;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoticeKind}" Value="{x:Static vm:NoticeKind.Error}">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding NoticeText}" FontWeight="Medium" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <!-- Tiêu đề cột -->
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1" Padding="8,10">
                    <Grid TextElement.Foreground="{StaticResource InkSoft}" TextElement.FontWeight="SemiBold"
                          TextElement.FontSize="12.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColIndex}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ColPrice}" />
                            <ColumnDefinition Width="{StaticResource ColQty}" />
                            <ColumnDefinition Width="{StaticResource ColTotal}" />
                            <ColumnDefinition Width="{StaticResource ColRemove}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="SẢN PHẨM" />
                        <TextBlock Grid.Column="2" Text="ĐƠN GIÁ" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="SỐ LƯỢNG" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="THÀNH TIỀN" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Chân: tổng dòng + phím tắt -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                   Text="Del: xóa dòng  ·  + / − : đổi số lượng  ·  F8: hủy đơn  ·  F9: thanh toán" />
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InkSoft}">
                            <Run Text="{Binding Items.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <Run Text="mặt hàng  ·  tổng số lượng" />
                            <Run Text="{Binding TotalQuantity, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Danh sách hàng -->
                <Grid>
                    <ListBox x:Name="CartList" Style="{StaticResource PlainList}"
                             ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             SelectionChanged="CartList_SelectionChanged">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
                            <KeyBinding Key="Add" Command="{Binding IncreaseSelectedCommand}" />
                            <KeyBinding Key="OemPlus" Command="{Binding IncreaseSelectedCommand}" />
                            <KeyBinding Key="Subtract" Command="{Binding DecreaseSelectedCommand}" />
                            <KeyBinding Key="OemMinus" Command="{Binding DecreaseSelectedCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CartItem}">
                                <Grid Margin="8,0" MinHeight="66">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColIndex}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource ColPrice}" />
                                        <ColumnDefinition Width="{StaticResource ColQty}" />
                                        <ColumnDefinition Width="{StaticResource ColTotal}" />
                                        <ColumnDefinition Width="{StaticResource ColRemove}" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource InkMuted}" FontWeight="SemiBold" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,12,8">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="42" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontSize="12.5"
                                                   Foreground="{StaticResource InkMuted}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}" />

                                    <Border Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8"
                                            Background="{StaticResource Surface}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&#xE738;" Style="{StaticResource StepButton}" ToolTip="Giảm 1"
                                                    Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Width="46" Padding="0" BorderThickness="0" Background="Transparent"
                                                     TextAlignment="Center" FontWeight="SemiBold" FontSize="15"
                                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="&#xE710;" Style="{StaticResource StepButton}" ToolTip="Tăng 1"
                                                    Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="4" Text="{Binding LineTotal, StringFormat={}{0:N0}}" FontSize="15"
                                               FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <Button Grid.Column="5" Content="&#xE74D;" Style="{StaticResource Btn.Icon}" ToolTip="Xóa khỏi đơn"
                                            Foreground="{StaticResource Danger}" HorizontalAlignment="Center" Focusable="False"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Giỏ trống -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}">
                        <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource PrimarySoft}">
                            <TextBlock Text="&#xE7BF;" Style="{StaticResource Text.Icon}" FontSize="36" Foreground="{StaticResource Primary}" />
                        </Border>
                        <TextBlock Text="Chưa có sản phẩm trong đơn" Style="{StaticResource Text.Section}"
                                   HorizontalAlignment="Center" Margin="0,18,0,6" />
                        <TextBlock Text="Quét mã vạch bằng đầu đọc hoặc nhập mã ở ô phía trên để bắt đầu"
                                   Foreground="{StaticResource InkSoft}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= THANH TOÁN ================= -->
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn.DangerOutline}" Height="60" Command="{Binding ClearCartCommand}">
                    <StackPanel>
                        <TextBlock Text="Hủy đơn" HorizontalAlignment="Center" />
                        <TextBlock Text="F8" FontSize="11.5" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Btn.Success}" Height="60" Command="{Binding CheckoutCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C7;" Style="{StaticResource Text.Icon}" FontSize="20" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="THANH TOÁN" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="F9" FontSize="11.5" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Thanh toán" Style="{StaticResource Text.Section}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tổng số lượng" Style="{StaticResource SummaryLabel}" />
                            <TextBlock Text="{Binding TotalQuantity}" Style="{StaticResource SummaryValue}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tạm tính" Style="{StaticResource SummaryLabel}" />
                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N0} ₫}" Style="{StaticResource SummaryValue}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Giảm giá" Style="{StaticResource SummaryLabel}" />
                            <TextBox Width="150" HorizontalAlignment="Right" TextAlignment="Right" Tag="0"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscountValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <!-- Khách cần trả -->
                        <Border Background="{StaticResource PrimarySoft}" BorderBrush="{StaticResource PrimaryLine}" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="KHÁCH CẦN TRẢ" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Primary}" />
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0} ₫}" FontSize="34" FontWeight="Bold"
                                           Foreground="{StaticResource Primary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Phương thức thanh toán" Style="{StaticResource Text.Label}" />
                        <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding PaymentMethods}"
                                 SelectedValuePath="Key" DisplayMemberPath="Value"
                                 SelectedValue="{Binding SelectedPaymentMethod}" />

                        <!-- Tiền mặt -->
                        <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                            <TextBlock Text="Khách đưa   (F4)" Style="{StaticResource Text.Label}" />
                            <TextBox x:Name="PaidBox" FontSize="20" FontWeight="SemiBold" Padding="14,9"
                                     TextAlignment="Right" HorizontalContentAlignment="Right"
                                     Tag="Để trống nếu khách đưa vừa đủ"
                                     Text="{Binding CustomerPaidText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CheckoutCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <ItemsControl ItemsSource="{Binding QuickCashOptions}" Margin="0,10,-8,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuickCashOption}">
                                        <Button Content="{Binding Label}" Padding="4,8" Margin="0,0,8,0" FontSize="13" Focusable="False"
                                                Command="{Binding DataContext.QuickCashCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Tiền thừa / còn thiếu -->
                            <Border CornerRadius="10" Padding="16,10" Margin="0,12,0,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessLine}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaidEnough}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerLine}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeDueAbs, StringFormat={}{0:N0} ₫}"
                                               FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Tiền thừa trả khách" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaidEnough}" Value="False">
                                                        <Setter Property="Text" Value="Khách còn thiếu" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Chuyển khoản / thẻ -->
                        <Border Visibility="{Binding IsCash, Converter={StaticResource InverseBoolToVis}}" Margin="0,18,0,0"
                                Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Text.Icon}"
                                           Foreground="{StaticResource InkSoft}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkSoft}"
                                           Text="Xác nhận khách đã chuyển khoản / quẹt thẻ đủ số tiền rồi bấm Thanh toán." />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
