<UserControl x:Class="CheckBarcodeSieuThi.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CheckBarcodeSieuThi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InvoicesViewModel}"
             d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= BỘ LỌC ================= -->
        <Border Style="{StaticResource Card}" Padding="20,16">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Từ ngày" Style="{StaticResource Text.Label}" />
                    <DatePicker Width="150" SelectedDate="{Binding FromDate}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Đến ngày" Style="{StaticResource Text.Label}" />
                    <DatePicker Width="150" SelectedDate="{Binding ToDate}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,0">
                    <Button Content="Hôm nay" Command="{Binding TodayCommand}" Margin="0,0,8,0" />
                    <Button Content="7 ngày" Command="{Binding Last7DaysCommand}" Margin="0,0,8,0" />
                    <Button Content="Tháng này" Command="{Binding ThisMonthCommand}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Số hóa đơn" Style="{StaticResource Text.Label}" />
                    <TextBox Width="200" Tag="Ví dụ: HD260925-0001" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding SearchCommand}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Tìm kiếm" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ================= THỐNG KÊ ================= -->
        <UniformGrid Grid.Row="2" Rows="1">
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIcon}" Background="{StaticResource PrimarySoft}">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="19" Foreground="{StaticResource Primary}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Số hóa đơn" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding InvoiceCount}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="5,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIcon}" Background="{StaticResource SuccessSoft}">
                        <TextBlock Text="&#xE8C7;" Style="{StaticResource Text.Icon}" FontSize="19" Foreground="{StaticResource Success}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Doanh thu" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Revenue, StringFormat={}{0:N0} ₫}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Success}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIcon}" Background="{StaticResource WarningSoft}">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="19" Foreground="{StaticResource Warning}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sản phẩm đã bán" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding ItemCount}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ================= DANH SÁCH + CHI TIẾT ================= -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SỐ HÓA ĐƠN" Binding="{Binding Number}" Width="170" FontFamily="Consolas"
                                                FontWeight="SemiBold" />
                            <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="160" />
                            <DataGridTextColumn Header="SL" Binding="{Binding TotalQuantity}" Width="70"
                                                HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.RightText}" />
                            <DataGridTextColumn Header="THANH TOÁN" Binding="{Binding PaymentMethodName}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding Total, StringFormat={}{0:N0} ₫}" Width="150"
                                                SortMemberPath="Total" HeaderStyle="{StaticResource Grid.HeaderRight}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Grid.RightText}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InvoiceCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" FontSize="40" Foreground="{StaticResource LineStrong}" />
                        <TextBlock Text="Không có hóa đơn trong khoảng thời gian này" Foreground="{StaticResource InkSoft}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Soft}" Padding="12,7" Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="In lại" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Chi tiết hóa đơn" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="0,14">
                        <Grid>
                            <FlowDocumentScrollViewer Document="{Binding PreviewDocument}" Width="318" HorizontalAlignment="Center"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      IsToolBarVisible="False" Background="Transparent" Focusable="False"
                                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Chọn một hóa đơn để xem chi tiết" Foreground="{StaticResource InkSoft}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
