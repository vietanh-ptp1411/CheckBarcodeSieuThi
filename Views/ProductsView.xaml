<UserControl x:Class="CheckBarcodeSieuThi.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CheckBarcodeSieuThi.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= FORM ================= -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource PrimarySoft}" Margin="0,0,12,0">
                        <TextBlock Foreground="{StaticResource Primary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                    <Setter Property="Text" Value="&#xE710;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="&#xE70F;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
                                <Setter Property="Text" Value="Thêm sản phẩm mới" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Sửa sản phẩm" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,20"
                           Text="Quét mã bằng đầu đọc khi đang ở trang này để điền nhanh barcode." />

                <TextBlock Text="Mã vạch (barcode)" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="BarcodeBox" FontFamily="Consolas" FontSize="15" Tag="Quét hoặc nhập, Enter để tra"
                         Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LookupCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="Tên sản phẩm" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                <TextBox x:Name="NameBox" Tag="Ví dụ: Sữa tươi Vinamilk 180ml"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Giá bán (đồng)" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                <TextBox x:Name="PriceBox" Tag="Ví dụ: 15.000" FontSize="15" FontWeight="SemiBold"
                         Text="{Binding EditPriceText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Border CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Success}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FormMessageIsError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FormMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding FormMessage}" TextWrapping="Wrap" FontWeight="Medium" />
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Thêm mới" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding UpdateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Lưu thay đổi" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2" Style="{StaticResource Btn.DangerOutline}" Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Xóa" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Btn.Ghost}" Command="{Binding ClearFormCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Làm mới form" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= DANH SÁCH ================= -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceAlt}" CornerRadius="14" Padding="12,5"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductCountText}" Foreground="{StaticResource InkSoft}" FontSize="13"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Danh mục sản phẩm" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBox Padding="40,9,12,9" Tag="Tìm theo mã vạch hoặc tên sản phẩm"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="14" HorizontalAlignment="Left"
                               Margin="14,0,0,0" Foreground="{StaticResource InkMuted}" IsHitTestVisible="False" />
                </Grid>

                <DataGrid x:Name="ProductGrid" ItemsSource="{Binding ProductsView}" SelectedItem="{Binding SelectedProduct}"
                          SelectionChanged="ProductGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MÃ VẠCH" Binding="{Binding Barcode}" Width="190" FontFamily="Consolas" />
                        <DataGridTextColumn Header="TÊN SẢN PHẨM" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="GIÁ BÁN" Binding="{Binding Price, StringFormat={}{0:N0} ₫}" Width="150"
                                            SortMemberPath="Price" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                            ElementStyle="{StaticResource Grid.RightText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
