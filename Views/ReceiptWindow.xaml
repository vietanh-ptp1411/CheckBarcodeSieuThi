<Window x:Class="CheckBarcodeSieuThi.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hóa đơn" Width="460" Height="780" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <!-- Kết quả thanh toán -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Success}" Padding="24,18"
                Visibility="{Binding IsNewSale, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="#FFFFFF" Margin="0,0,14,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="{StaticResource Success}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Thanh toán thành công" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Foreground="White" Opacity="0.85" Margin="0,2,0,0">
                        <Run Text="{Binding Invoice.Number, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding Invoice.PaymentMethodName, Mode=OneWay}" />
                    </TextBlock>
                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Invoice.ChangeDue, StringFormat={}{0:N0} ₫}"
                                       Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="Tiền thừa trả khách" Foreground="White" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nút -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Click="Print_Click" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="In hóa đơn  (Ctrl+P)" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Content="Đóng  (Esc)" IsCancel="True" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <!-- Xem trước -->
        <FlowDocumentScrollViewer x:Name="Viewer" Width="318" HorizontalAlignment="Center" Margin="0,18"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsToolBarVisible="False" Background="Transparent" Focusable="False" />
    </DockPanel>
</Window>
